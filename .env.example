# Example environment variables for Inventory System
# Copy to `.env` and fill in real secrets. NEVER commit real secrets to git.

# Database (Postgres / Supabase)
DB_URL=jdbc:postgresql://host:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=nq4OHpCmxHzKog2m
DB_POOL_SIZE=5

# JWT secret (generate with `openssl rand -base64 64`)
JWT_SECRET=replace-with-a-long-random-secret

# Server
PORT=8080

# Optional admin bootstrap (only set if you need the app to auto-create the first admin)
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=ChangeMeNow123!

# CORS
CORS_ALLOWED_ORIGINS=https://final-year-project-oref.onrender.com,http://localhost:5500,http://127.0.0.1
